@model Movie

@{
    ViewData["Title"] = "Add Movie";
}



<div class="text-center">
    <h1>
        Add a Movie to Joel's Collection'
    </h1>
    <h5>We all know Pride and Prejudice is a superior film</h5>
</div>

<div class="text-center">
    <form method="post">

        <br /> 
        <label asp-for="Title">Title</label>
        <input required asp-for="Title" />
        <br />
         <select>
            <option value="">Select a Category</option>
            @foreach(Categories c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
        <br />
        <label asp-for="Year">Year</label>
        <input required asp-for="Year" />
        <br />
        <label asp-for="Director">Director</label>
        <input required asp-for="Director" />
        <br />
        <label asp-for="Rating">Rating</label>
        <select required asp-for="Rating">
            <option value="NR">NR</option>
            <option value="UR">UR</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
            <option value="TV-Y7">TV-Y7</option>
            <option value="TV-PG">TV-PG</option>
            <option value="TV-14">TV-14</option>
            <option value="TV-MA">TV-MA</option>
        </select>
        
        <br />
        <label asp-for="Edited">Edited?</label>
        <select asp-for="Edited">
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
        <br />
        <label asp-for="LentTo">Lent To:</label>
        <input asp-for="LentTo" />
        <br />
        <label asp-for="CopiedToPlex">Copied to Plex?</label>
        <select asp-for="CopiedToPlex">
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
     
        <br />
        <label asp-for="Notes">Notes:</label>
        <textarea maxlength="50" asp-for="Notes"></textarea>
        
        <br />
        <button type="submit">Add Movie</button>
    </form>

</div>