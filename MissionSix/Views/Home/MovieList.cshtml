@{
}
@model List<Movie>

<table class="table table-borders">
    <thead>
        <tr>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Category</th>
            <th>Edited</th>
            <th>Copied to Plex?</th>
            <th>Notes</th>
        </tr>
    </thead>
    
        
         @foreach (var x in Model )
        {

            <tbody>
            <tr>
                <td>@x.Title</td>
                <td>@x.Year</td>
                <td>@x.Director</td>
                <td>@x.Rating</td>
                <td>@x.CategoryId</td>
                <td>@x.Edited</td>
                <td>@x.CopiedToPlex</td>
                <td>@x.Notes</td>
            </tr>
            </tbody>
         }
         
</table>